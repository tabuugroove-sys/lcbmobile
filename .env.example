# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- General ---
CHANNEL_NAME=LCB Mobile
CHANNEL_HANDLE=@lcbmobile
CONTENT_LANG=pt-BR
TIMEZONE=America/Sao_Paulo
DB_PATH=data/state.db
OUTPUT_DIR=out

# --- Pipeline ---
MAX_ITEMS_PER_RUN=3
DRY_RUN=false

# --- TTS ---
# Provider: "elevenlabs" (premium voice) or "gtts" (free, default fallback).
# If "elevenlabs" is selected but ELEVENLABS_API_KEY is empty, gTTS is used.
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# Voice ID from your ElevenLabs library. Default below is "Rachel" - swap for a
# pt-BR voice for best results (e.g., a Brazilian voice from the voice library).
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# eleven_multilingual_v2 is the recommended model for pt-BR.
ELEVENLABS_MODEL=eleven_multilingual_v2
# Voice settings (0.0 - 1.0)
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY=0.8
ELEVENLABS_STYLE=0.35

# --- YouTube (Data API v3, OAuth) ---
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json
YOUTUBE_CATEGORY_ID=24

# --- Instagram (Graph API for Business accounts) ---
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# Public URL prefix where generated videos are hosted (Instagram requires URL)
INSTAGRAM_PUBLIC_BASE_URL=

# --- TikTok (Content Posting API) ---
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# --- Twitter / X (API v2 + media upload) ---
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# --- Telegram (Bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@your_channel
