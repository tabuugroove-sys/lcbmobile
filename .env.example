# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- General ---
CHANNEL_NAME=LCB Mobile
CHANNEL_HANDLE=@lcbmobile
CONTENT_LANG=pt-BR
TIMEZONE=America/Sao_Paulo
DB_PATH=data/state.db
OUTPUT_DIR=out

# --- Pipeline ---
MAX_ITEMS_PER_RUN=3
MAX_ATTEMPTS_PER_ITEM=5
RETRY_DELAY_SECONDS=200
FALLBACK_TO_YESTERDAY=true
ANALYTICS_ENABLED=true
ANALYTICS_CANDIDATE_POOL=40
ANALYTICS_HISTORY_LIMIT=250
YOUTUBE_METRICS_REFRESH_HOURS=6
DRY_RUN=false

# --- TTS ---
# Provider: "elevenlabs" (premium voice) or "gtts" (free, default fallback).
# If "elevenlabs" is selected but ELEVENLABS_API_KEY is empty, gTTS is used.
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# Voice ID from your ElevenLabs library. Default below is "Rachel" - swap for a
# pt-BR voice for best results (e.g., a Brazilian voice from the voice library).
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# eleven_multilingual_v2 is the recommended model for pt-BR.
ELEVENLABS_MODEL=eleven_multilingual_v2
# Voice settings (0.0 - 1.0)
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY=0.8
ELEVENLABS_STYLE=0.35

# --- YouTube (Data API v3, OAuth) ---
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json
YOUTUBE_CATEGORY_ID=24
# Optional public Data API key for refreshing video statistics.
# If empty, the pipeline tries the existing OAuth token instead.
YOUTUBE_API_KEY=

# --- Instagram (Graph API for Business accounts) ---
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# Public URL prefix where generated videos are hosted (Instagram requires URL)
INSTAGRAM_PUBLIC_BASE_URL=

# --- TikTok (Content Posting API) ---
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# --- Twitter / X (API v2 + media upload) ---
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# --- Telegram (Bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@your_channel

# --- Webhook (Make.com / Zapier / n8n -> YouTube/IG/TikTok) ---
# Cloud-only path: pipeline uploads the .mp4 to a GitHub Release in this repo
# (using GITHUB_TOKEN that Actions provides automatically), then POSTs the
# public asset URL + metadata to WEBHOOK_URL. Make.com / Zapier picks it up
# and uploads to YouTube/IG/TikTok via their pre-approved connectors.
# See docs/MAKE_SETUP.md for the phone-only walkthrough.
WEBHOOK_URL=
# Optional auth header sent with the webhook POST (e.g. "Bearer abc123")
WEBHOOK_AUTH_HEADER=
# Comma-separated platform hints forwarded in the JSON payload
WEBHOOK_TARGETS=youtube,instagram,tiktok
